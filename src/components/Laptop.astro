---
// The laptop's operating system: a monochrome registry terminal. It's plain
// HTML, so it can be typed into, read aloud and played with the keyboard;
// src/scripts/laptop.js runs it. In the live scene it sits on the 3D
// screen; without the live scene it opens in a dialog.
//
// The words are in src/data/copy.json, messages newest first. A message
// waits for the step AFTER names, if any, to be done.

import copy from '../data/copy.json';

const words = copy.laptop;
const AFTER = { 'ai-thanks': 'clear', channel: 'goat', thanks: 'song', 'major-tom': 'snake' };

// The rescue at the end (laptop.js): the crew's control page and the flight
// code the ship's AI sends, as the player first sees them.
const CONTROL_PAGE = `<!-- Manual flight controls. Built with bezel.js 1.4 (2009). -->
<div class="bezel" data-bezel-locked="true">
  <p class="bezel-notice">
    Our AI is flying. Manual control is no longer needed.
  </p>
  <div class="bezel-controls">
    <button data-bezel-action="manual">Take manual control</button>
  </div>
</div>`;
const FLIGHT_CODE = `// Thrust per pulse, from the propulsion table.
// The table is in pound-force seconds (lbf·s).
const PULSE = 220;
const MASS = 184000; // kg
const CLIMB = 21; // m/s, to clear the rings

// Pulses to climb out: impulse (N·s) = mass × change in speed.
function pulsesNeeded() {
  return Math.ceil((MASS * CLIMB) / PULSE);
}`;
---

<div class="os" id="laptop-os" data-screen="lock">
	<header class="os-bar">
		<span>{words.bar}</span>
		<span class="os-clock"></span>
	</header>

	<section class="os-screen os-lock" data-screen-name="lock" aria-label={words.lock.title}>
		<p class="os-big">{words.lock.heading}</p>
		<form class="os-login">
			<p class="os-field">{words.lock.user} <span>{words.lock.name}</span></p>
			<label class="os-field">
				{words.lock.password}
				<input name="password" type="password" autocomplete="off" spellcheck="false" />
			</label>
			<button class="os-button" type="submit">{words.lock.button}</button>
		</form>
		<p class="os-dim">{words.lock.hint}</p>
		<p class="os-status" aria-live="polite"></p>
	</section>

	<section class="os-screen" data-screen-name="home" aria-label={words.home.title} hidden>
		<p class="os-big">{words.home.welcome}</p>
		<p class="os-dim os-unread"></p>
		<nav class="os-menu">
			<button class="os-button" type="button" data-go="messages">{words.home.menu.messages}</button>
			<button class="os-button" type="button" data-go="registry">{words.home.menu.registry}</button>
			<button class="os-button" type="button" data-go="settings">{words.home.menu.settings}</button>
			<button class="os-button" type="button" data-go="snake">{words.home.menu.snake}</button>
			<button class="os-button" type="button" data-go="portfolio" data-after="restored" hidden>{words.home.menu.portfolio}</button>
			<button class="os-button" type="button" data-go="photos" data-after="restored" hidden>{words.home.menu.photos}</button>
			<button class="os-button" type="button" data-go="link" data-after="goat" hidden>{words.home.menu.link}</button>
		</nav>
	</section>

	<section class="os-screen" data-screen-name="messages" aria-label={words.messages.title} hidden>
		<p class="os-title"><button class="os-back" type="button" data-go="home">{words.back}</button> {words.messages.title}</p>
		<ul class="os-list"></ul>
		<button class="os-back os-to-list" type="button" hidden>{words.messages.all}</button>
		<div class="os-messages">
			{
				Object.entries(words.messages.list).map(([id, message]) => (
					<article data-id={id} data-after={AFTER[id]}>
						<h3>{message.from}</h3>
						<p class="os-subject">{message.subject}</p>
						{message.body.map((paragraph) => <p>{paragraph}</p>)}
					</article>
				))
			}
		</div>
	</section>

	<section class="os-screen" data-screen-name="registry" aria-label={words.registry.title} hidden>
		<p class="os-title"><button class="os-back" type="button" data-go="home">{words.back}</button> {words.registry.title}</p>
		<form class="os-check">
			<label class="os-field">
				{words.registry.callSign}
				<input name="call" maxlength="8" autocomplete="off" spellcheck="false" />
			</label>
			<button class="os-button" type="submit">{words.registry.check}</button>
		</form>
		<p class="os-result" aria-live="polite"></p>
		<canvas class="os-goat" width="512" height="320" role="img" aria-label={words.registry.logo} hidden></canvas>
		<div class="os-recent">
		<p class="os-dim">{words.registry.recent}</p>
		<table class="os-table">
			<thead>
				<tr>{words.registry.columns.map((column) => <th>{column}</th>)}</tr>
			</thead>
			<tbody>
				{words.registry.ships.map((ship) => <tr data-call={ship[0]}>{ship.map((cell) => <td>{cell}</td>)}</tr>)}
			</tbody>
		</table>
		</div>
		<!-- The ship that passes, found once it has (see laptop.js). -->
		<template class="os-passing">{words.registry.passing}</template>
	</section>

	<section
		class="os-screen"
		data-screen-name="settings"
		aria-label={words.settings.title}
		data-restore-ask={words.settings.restoreAsk}
		data-restore-done={words.settings.restoreDone}
		data-restore-wrong={words.settings.restoreWrong}
		data-restored={words.settings.restored}
		hidden
	>
		<p class="os-title"><button class="os-back" type="button" data-go="home">{words.back}</button> {words.settings.title}</p>
		<div class="os-setting">
			<p>{words.settings.gravity} <span class="os-dim os-gravity-state">{words.settings.gravityLocked}</span></p>
			<button class="os-button" type="button" data-setting="gravity">{words.settings.enable}</button>
		</div>
		<div class="os-setting">
			<p>{words.settings.restore} <span class="os-dim os-restore-state">{words.settings.restoreState}</span></p>
			<button class="os-button" type="button" data-setting="restore">{words.settings.restoreButton}</button>
		</div>
		<form class="os-restore" hidden>
			<label class="os-field">
				{words.settings.restorePassword}
				<input name="password" type="password" autocomplete="off" spellcheck="false" />
			</label>
		</form>
		<div class="os-setting">
			<p>{words.settings.alerts}</p>
			<button class="os-button" type="button" data-setting="alerts" aria-pressed="true">{words.settings.on}</button>
		</div>
		<div class="os-setting">
			<p>{words.settings.lock}</p>
			<button class="os-button" type="button" data-setting="lock">{words.settings.lockButton}</button>
		</div>
		<div class="os-setting">
			<p>{words.settings.reset} <span class="os-dim">{words.settings.resetNote}</span></p>
			<button class="os-button" type="button" data-setting="reset">{words.settings.resetButton}</button>
		</div>
		<p class="os-status" aria-live="polite"></p>
	</section>

	<section class="os-screen os-portfolio" data-screen-name="portfolio" aria-label={words.portfolio.title} hidden>
		<p class="os-title"><button class="os-back" type="button" data-go="home">{words.back}</button> {words.portfolio.title} <span class="os-dim">{words.portfolio.from}</span></p>
		<div class="os-entries">
			{
				words.portfolio.entries.map((entry) => (
					<article>
						<h3>{entry.title}</h3>
						{entry.body.map((paragraph) => <p set:html={paragraph} />)}
					</article>
				))
			}
		</div>
	</section>

	<!-- Stand-ins, drawn by laptop.js, until there are real photos to dither. -->
	<section class="os-screen os-photos" data-screen-name="photos" aria-label={words.photos.title} hidden>
		<p class="os-title"><button class="os-back" type="button" data-go="home">{words.back}</button> {words.photos.title} <span class="os-dim">{words.photos.from}</span></p>
		<div class="os-album">
			{
				['mum', 'barry', 'hackday', 'launch'].map((photo) => (
					<figure>
						<canvas class="os-photo" data-photo={photo} width="480" height="320" role="img" aria-label={words.photos.album[photo].alt}></canvas>
						<figcaption>{words.photos.album[photo].caption}</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="os-screen os-link" data-screen-name="link" aria-label={words.link.title} hidden>
		<p class="os-title"><button class="os-back" type="button" data-go="home">{words.back}</button> {words.link.heading}</p>
		<div
			class="os-step"
			data-step="page"
			data-notice={words.link.page.notice}
			data-hint-first={words.link.page.hintFirst}
			data-hint-last={words.link.page.hintLast}
			hidden
		>
			<p class="os-ai">{words.link.page.intro}</p>
			<div class="os-work">
				<textarea class="os-code" spellcheck="false" aria-label={words.link.page.code}>{CONTROL_PAGE}</textarea>
				<iframe class="os-preview" title={words.link.page.preview} sandbox="allow-same-origin"></iframe>
			</div>
			<div class="os-run">
				<button class="os-button" type="button" data-reset>{words.link.reset}</button>
				<p class="os-reply" aria-live="polite"></p>
			</div>
		</div>
		<div
			class="os-step"
			data-step="units"
			data-error={words.link.units.error}
			data-nan={words.link.units.nan}
			data-right={words.link.units.right}
			data-high={words.link.units.high}
			data-low={words.link.units.low}
			data-hint-first={words.link.units.hintFirst}
			data-hint-last={words.link.units.hintLast}
			hidden
		>
			<p class="os-ai">{words.link.units.intro}</p>
			<textarea class="os-code" spellcheck="false" aria-label={words.link.units.code}>{FLIGHT_CODE}</textarea>
			<div class="os-run">
				<button class="os-button" type="button" data-run>{words.link.run}</button>
				<button class="os-button" type="button" data-reset>{words.link.reset}</button>
				<button class="os-button" type="button" data-sign hidden>{words.link.signOff}</button>
				<p class="os-reply" aria-live="polite"></p>
			</div>
		</div>
		<div class="os-step" data-step="choice" hidden>
			<p class="os-ai">{words.link.choice.intro}</p>
			<div class="os-options">
				<button class="os-button" type="button" data-reply={words.link.choice.options.luggage.reply}>{words.link.choice.options.luggage.label}</button>
				<button class="os-button" type="button" data-reply={words.link.choice.options.stage.reply}>{words.link.choice.options.stage.label}</button>
				<button class="os-button" type="button" data-reply={words.link.choice.options.lifeboats.reply}>{words.link.choice.options.lifeboats.label}</button>
				<button class="os-button" type="button" data-racks data-reply={words.link.choice.options.racks.reply}>{words.link.choice.options.racks.label}</button>
			</div>
			<p class="os-reply" aria-live="polite"></p>
			<button class="os-button os-confirm" type="button" hidden>{words.link.choice.jettison}</button>
		</div>
		<div class="os-step" data-step="done" hidden>
			<p class="os-ai">{words.link.done}</p>
		</div>
	</section>

	<section class="os-screen os-snake" data-screen-name="snake" aria-label={words.snake.title} hidden>
		<p class="os-title"><button class="os-back" type="button" data-go="home">{words.back}</button> {words.snake.title} <span class="os-score"></span></p>
		<div class="os-game">
			<canvas width="1200" height="720" tabindex="0" aria-label={words.snake.canvas}></canvas>
			<div class="os-pad" aria-label={words.snake.steer}>
				<button class="os-button" type="button" data-turn="up" aria-label={words.snake.turn.up}>▲</button>
				<button class="os-button" type="button" data-turn="left" aria-label={words.snake.turn.left}>◀</button>
				<button class="os-button" type="button" data-turn="right" aria-label={words.snake.turn.right}>▶</button>
				<button class="os-button" type="button" data-turn="down" aria-label={words.snake.turn.down}>▼</button>
			</div>
		</div>
		<p class="os-dim os-snake-status" aria-live="polite">{words.snake.help}</p>
	</section>
</div>

<style>
	/* Sized by its container: the 3D screen's 1024 by 640, or a dialog. */
	.os {
		--ink: #cfe9ec;
		--paper: var(--os-bg, #17323b);
		position: relative;
		box-sizing: border-box;
		width: 1024px;
		height: 640px;
		overflow: hidden;
		container-type: size;
		display: flex;
		flex-direction: column;
		background: var(--paper);
		color: var(--ink);
		/* The text's size is set inside (.os-bar, .os-screen), where cqw
		   measures this box. Here it would measure the browser window. */
		font: 500 14px / 1.45 ui-monospace, Menlo, Consolas, monospace;
		text-transform: uppercase;
	}
	/* The screen's smudges, as in the still. */
	.os::after {
		content: '';
		position: absolute;
		inset: 0;
		background: url('/scene/screen-smudge.webp') center / 100% 100%;
		mix-blend-mode: screen;
		opacity: 0.18;
		pointer-events: none;
	}
	.os-bar {
		display: flex;
		justify-content: space-between;
		padding: 1.4cqw 3cqw;
		border-bottom: 0.2cqw solid rgb(207 233 236 / 0.4);
		font-size: max(1.7cqw, 11px);
		letter-spacing: 0.04em;
		opacity: 0.8;
	}
	/* Anything longer than the screen scrolls. */
	.os-screen {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding: 2.4cqw 4cqw;
		/* Never smaller than this, so it reads in a dialog on a phone. */
		font-size: max(2.2cqw, 14px);
		letter-spacing: 0.04em;
		scrollbar-width: thin;
		scrollbar-color: var(--ink) transparent;
	}
	.os p {
		margin: 0 0 1.4cqw;
	}
	.os-big {
		font-size: max(3cqw, 18px);
	}
	.os-title {
		display: flex;
		gap: 2cqw;
		align-items: center;
		font-size: max(2.6cqw, 16px);
	}
	.os-dim {
		opacity: 0.6;
	}
	.os-score {
		margin-left: auto;
	}
	.os-button,
	.os-back,
	.os input {
		font: inherit;
		text-transform: inherit;
		letter-spacing: inherit;
		color: var(--ink);
		background: transparent;
		border: 0.2cqw solid var(--ink);
		border-radius: 0;
		padding: 0.6cqw 1.6cqw;
	}
	.os-back {
		border-color: transparent;
		padding-inline: 0;
	}
	.os-button:hover,
	.os-button:focus-visible,
	.os-button[aria-pressed='true'],
	.os-back:hover,
	.os-back:focus-visible,
	.os-list :global(button:hover),
	.os-list :global(button:focus-visible) {
		background: var(--ink);
		color: var(--paper);
		outline: none;
	}
	.os input {
		width: 24cqw;
		margin-left: 1cqw;
	}
	.os input:focus {
		outline: 0.2cqw solid var(--ink);
		outline-offset: 0.3cqw;
	}
	.os-field {
		display: block;
		margin-bottom: 1.6cqw;
	}
	.os-menu {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2cqw;
		max-width: 60cqw;
		margin-top: 3cqw;
	}
	.os-menu .os-button {
		padding-block: 2cqw;
	}
	.os-list {
		margin: 0 0 2cqw;
		padding: 0;
		list-style: none;
		font-size: max(1.9cqw, 13px);
	}
	/* The list is built by laptop.js, so its rules reach in with :global. */
	.os-list :global(button) {
		display: grid;
		grid-template-columns: 2.4cqw 26cqw 1fr;
		width: 100%;
		padding: 0.3cqw 1cqw;
		font: inherit;
		text-transform: inherit;
		letter-spacing: inherit;
		text-align: left;
		color: var(--ink);
		background: transparent;
		border: 0;
	}
	.os-messages article {
		border-top: 0.2cqw solid rgb(207 233 236 / 0.4);
		padding-top: 1.4cqw;
		text-transform: none;
	}
	.os-messages h3 {
		margin: 0;
		color: inherit;
		font: inherit;
		text-transform: uppercase;
	}
	.os-table {
		width: 100%;
		border-collapse: collapse;
		font-size: max(1.9cqw, 12px);
	}
	.os-table th,
	.os-table td {
		padding: 0.5cqw 1cqw 0.5cqw 0;
		text-align: left;
		border-bottom: 0.15cqw solid rgb(207 233 236 / 0.25);
	}
	.os-goat {
		display: block;
		width: 30cqw;
		height: auto;
		image-rendering: pixelated;
	}
	.os-goat[hidden] {
		display: none;
	}
	.os-setting {
		display: flex;
		gap: 3cqw;
		align-items: center;
		justify-content: space-between;
		padding: 1cqw 0;
		border-bottom: 0.15cqw solid rgb(207 233 236 / 0.25);
	}
	.os-setting p {
		margin: 0;
	}
	.os-setting .os-dim {
		display: block;
		font-size: max(1.7cqw, 12px);
	}
	.os-restore input {
		width: 30cqw;
	}
	/* The portfolio and the ship link are read and typed, not shouted: as
	   written, and smaller. */
	.os-entries,
	.os-step {
		text-transform: none;
		font-size: max(1.65cqw, 12px);
	}
	.os-album {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2cqw 3cqw;
		text-transform: none;
		font-size: max(1.65cqw, 12px);
	}
	.os-album figure {
		margin: 0;
	}
	.os-photo {
		display: block;
		width: 100%;
		height: auto;
		border: 0.2cqw solid rgb(207 233 236 / 0.4);
		image-rendering: pixelated;
	}
	.os-album figcaption {
		margin-top: 0.6cqw;
	}
	.os-entries article {
		border-top: 0.2cqw solid rgb(207 233 236 / 0.4);
		padding-top: 1cqw;
	}
	.os-entries h3 {
		margin: 0 0 0.6cqw;
		color: inherit;
		font: inherit;
		text-transform: uppercase;
	}
	/* Portfolio paragraphs come from copy.json as HTML, outside this file's scope. */
	.os :global(code) {
		font: inherit;
		border-bottom: 0.15cqw solid rgb(207 233 236 / 0.5);
	}
	.os-ai {
		min-height: 3lh;
	}
	.os-work {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: 2cqw;
	}
	.os-code {
		box-sizing: border-box;
		width: 100%;
		height: 27cqw;
		padding: 1cqw;
		font: 500 max(1.55cqw, 12px) / 1.4 ui-monospace, Menlo, Consolas, monospace;
		text-transform: none;
		letter-spacing: 0;
		tab-size: 2;
		color: var(--ink);
		background: rgb(0 0 0 / 0.18);
		border: 0.2cqw solid var(--ink);
		border-radius: 0;
		resize: none;
	}
	/* The flight code is short; its hints run to three lines beside the buttons. */
	.os-step[data-step='units'] .os-code {
		height: 24cqw;
	}
	.os-code:focus {
		outline: 0.2cqw solid var(--ink);
		outline-offset: 0.3cqw;
	}
	.os-preview {
		box-sizing: border-box;
		width: 100%;
		height: 27cqw;
		background: var(--paper);
		border: 0.2cqw dashed var(--ink);
	}
	.os-run {
		display: flex;
		gap: 2cqw;
		align-items: flex-start;
		margin-top: 1.4cqw;
	}
	.os-run .os-reply {
		flex: 1;
		margin: 0;
	}
	.os-options {
		display: grid;
		gap: 1cqw;
		margin-bottom: 1.4cqw;
	}
	.os-options .os-button,
	.os-confirm {
		text-align: left;
	}
	.os-game {
		display: flex;
		gap: 3cqw;
		align-items: center;
	}
	.os-game canvas {
		width: 66cqw;
		height: auto;
		aspect-ratio: 30 / 18;
		border: 0.2cqw solid var(--ink);
	}
	.os-game canvas:focus-visible {
		outline: 0.2cqw solid var(--ink);
		outline-offset: 0.4cqw;
	}
	.os-pad {
		display: grid;
		grid-template: '. up .' 'left . right' '. down .' / repeat(3, 6cqw);
		gap: 0.6cqw;
	}
	.os-pad [data-turn='up'] {
		grid-area: up;
	}
	.os-pad [data-turn='left'] {
		grid-area: left;
	}
	.os-pad [data-turn='right'] {
		grid-area: right;
	}
	.os-pad [data-turn='down'] {
		grid-area: down;
	}
	.os-pad .os-button {
		padding: 0;
		aspect-ratio: 1;
	}
	/* Narrow, in a dialog on a phone: the game above its pad. */
	@container (max-width: 600px) {
		.os-game {
			flex-direction: column;
		}
		.os-game canvas {
			width: 100%;
		}
		.os-pad {
			grid-template-columns: repeat(3, 48px);
		}
		.os-menu {
			max-width: none;
		}
		.os-work {
			grid-template-columns: 1fr;
		}
		.os-code,
		.os-step[data-step='units'] .os-code,
		.os-preview {
			height: 220px;
		}
	}
</style>
